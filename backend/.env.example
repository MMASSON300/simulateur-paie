# Copiez ce fichier vers `.env` et adaptez les valeurs.
# Le fichier `.env` ne doit jamais être versionné.

# Mot de passe d'accès à l'interface d'administration.
ADMIN_PASSWORD=admin

# Durée de validité d'une session d'administration (en secondes, 24 h par défaut).
SESSION_TTL=86400

# URL de connexion à la base de données (SQLite par défaut).
# DATABASE_URL=sqlite:///paie.db
