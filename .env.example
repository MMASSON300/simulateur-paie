# Copiez ce fichier vers `.env` et adaptez les valeurs.
# Le fichier `.env` n'est jamais versionné.

# Mot de passe de l'interface d'administration.
ADMIN_PASSWORD=admin

# Port d'écoute sur la machine hôte (docker-compose).
PORT=8080

# Durée de validité d'une session d'administration (secondes).
SESSION_TTL=86400
